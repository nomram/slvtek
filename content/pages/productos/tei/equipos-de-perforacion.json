    "en": {
      "title": "Drill rigs",
      "h1": "Drill rigs",
      "description": "TD is a series of electric/hydraulic drilling machines for limited-access drilling (cellar rigs), designed to install micropiles and self-drilling anchors…",
      "blocks": [
        {
          "type": "image",
